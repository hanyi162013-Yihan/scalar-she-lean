module

public import SHEStochastic.BCFPastTesting
public import SHEStochastic.AdaptedCanonicalPathTests
public import Mathlib.Topology.Metrizable.Uniformity

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency true
noncomputable section

namespace SHEStochastic.CanonicalCylinderRecognition
open MeasureTheory TopologicalSpace StoppedPathPasting PastedPastTests PastedGeneratorFunctional
open AdaptedCanonicalPathTests
open scoped NNReal

variable {E : Type*} [AddCommGroup E] [TopologicalSpace E] [IsTopologicalAddGroup E]
  [T2Space E] [MetrizableSpace E] [MeasurableSpace E] [BorelSpace E]
  [SecondCountableTopology E] (H : ℝ≥0)

def history (t : ℝ≥0) : Path H E → Path H E := stopped H (clock H t)

theorem continuous_history (t : ℝ≥0) : Continuous (history (E := E) H t) :=
  (continuous_stopped H).comp (continuous_const.prodMk continuous_id)

theorem history_comp (s t : ℝ≥0) (hst : s ≤ t) :
    history (E := E) H s ∘ history H t = history H s := by
  funext x
  apply ContinuousMap.ext
  intro u
  change x ⟨min (min u.val (min (s : ℝ) H)) (min (t : ℝ) H), _⟩ =
    x ⟨min u.val (min (s : ℝ) H), _⟩
  congr 2
  exact min_eq_left ((min_le_right _ _).trans (min_le_min_right _ (by exact_mod_cast hst)))

/-- The full canonical history filtration, including every component
of the state (in particular the retained driver). -/
def filtration : Filtration ℝ≥0 (inferInstance : MeasurableSpace (Path H E)) where
  seq t := MeasurableSpace.comap (history H t) inferInstance
  mono' s t hst := by
    calc
      _ = MeasurableSpace.comap (history H t)
          (MeasurableSpace.comap (history H s) inferInstance) := by
            rw [MeasurableSpace.comap_comp, history_comp H s t hst]
      _ ≤ _ := MeasurableSpace.comap_mono (continuous_history H s).measurable.comap_le
  le' t := (continuous_history H t).measurable.comap_le

theorem adapted (t : Time H) :
    Measurable[filtration (E := E) H (toNN H t)] (fun x : Path H E ↦ x t) := by
  have hm := (ContinuousMap.measurable_eval t).comp
    (Measurable.of_comap_le (f := history (E := E) H (toNN H t)) le_rfl)
  have he : (fun x : Path H E ↦ history H (toNN H t) x t) = fun x ↦ x t := by
    funext x
    change x (pastTime H (clock H (toNN H t)) t) = x t
    rw [clock_toNN]
    congr 1
    exact Subtype.ext (min_self _)
  exact he ▸ hm

def process (f b : BoundedContinuousFunction E ℝ) := martingale H (id : Path H E → Path H E) f b

theorem memLp (μ : Measure (Path H E)) [IsProbabilityMeasure μ]
    (f b : BoundedContinuousFunction E ℝ) (t : ℝ≥0) : MemLp (process H f b t) 2 μ := by
  apply MemLp.of_bound
    (((continuous_value H f b f.continuous b.continuous).comp
      (continuous_id.prodMk continuous_const)).stronglyMeasurable.aestronglyMeasurable)
    (2 * ‖f‖ + ‖b‖ * H)
  exact Filter.Eventually.of_forall fun x ↦ norm_value_bound H f b x (clock H t)

/-- The continuous past-test identities are equivalent to an ordinary
martingale on the genuine canonical filtration. L2 density supplies
all measurable past events, so no stronger test assumption is needed. -/
theorem martingale_of_identity (μ : Measure (Path H E)) [IsProbabilityMeasure μ]
    (f b : BoundedContinuousFunction E ℝ)
    (h : PastedCylinderMartingale.Identity H f b μ) :
    Martingale (process H f b) (filtration H) μ := by
  letI : MetricSpace (Path H E) := TopologicalSpace.metrizableSpaceMetric _
  have ha := martingale_adapted H (filtration H) (id : Path H E → Path H E) f b (adapted H)
  refine ⟨ha, fun s t hst ↦ ?_⟩
  apply (ae_eq_condExp_of_forall_setIntegral_eq ((filtration H).le s)
    ((memLp H μ f b t).integrable one_le_two)
    (fun _ _ _ ↦ ((memLp H μ f b s).integrable one_le_two).integrableOn)
    (fun A hA _ ↦ ?_) (ha s).aestronglyMeasurable).symm
  have htest (ψ : BoundedContinuousFunction (Path H E) ℝ) :
      (∫ x, ψ (history H s x) * (process H f b t x-process H f b s x) ∂μ) = 0 := by
    apply h (clock H s) (clock H t) (min_le_min_right _ (by exact_mod_cast hst))
      (ψ.compContinuous ⟨history H s, continuous_history H s⟩)
    intro x y hxy
    apply congrArg ψ
    apply ContinuousMap.ext
    intro u
    exact hxy (pastTime H (clock H s) u) (min_le_right _ _)
  have hz := BCFPastTesting.setIntegral_zero μ (history H s) (continuous_history H s).measurable
    (fun x ↦ process H f b t x-process H f b s x)
    ((memLp H μ f b t).sub (memLp H μ f b s)) htest hA
  rw [integral_sub ((memLp H μ f b t).integrable one_le_two).integrableOn
    ((memLp H μ f b s).integrable one_le_two).integrableOn] at hz
  exact (sub_eq_zero.mp hz).symm

/-- The same recognition applies to any presentation of a canonical
path law, provided its filtration is generated by the path's past. -/
theorem along_path {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (F : Filtration ℝ≥0 ‹MeasurableSpace Ω›)
    (X : Ω → Path H E) (hX : Measurable X)
    (hadapt : ∀ t : Time H, Measurable[F (toNN H t)] (fun sample ↦ X sample t))
    (hF : ∀ s, F s ≤ MeasurableSpace.comap (fun sample ↦ history H s (X sample)) inferInstance)
    (f b : BoundedContinuousFunction E ℝ)
    (h : PastedCylinderMartingale.Identity H f b (μ.map X)) :
    Martingale (martingale H X f b) F μ := by
  letI : MetricSpace (Path H E) := TopologicalSpace.metrizableSpaceMetric _
  have ha := martingale_adapted H F X f b hadapt
  apply BCFPastTesting.martingale μ F (fun s sample ↦ history H s (X sample))
    (fun s ↦ (continuous_history H s).measurable.comp hX) hF _ ha
  · intro t
    exact MemLp.of_bound ((ha t).mono (F.le t)).aestronglyMeasurable
      (2 * ‖f‖ + ‖b‖ * H)
      (Filter.Eventually.of_forall fun sample ↦ norm_value_bound H f b (X sample) (clock H t))
  · intro s t hst ψ
    have hh := h (clock H s) (clock H t) (min_le_min_right _ (by exact_mod_cast hst))
      (ψ.compContinuous ⟨history H s, continuous_history H s⟩) (by
        intro x y hxy
        apply congrArg ψ
        apply ContinuousMap.ext
        intro u
        exact hxy (pastTime H (clock H s) u) (min_le_right _ _))
    rw [integral_map hX.aemeasurable] at hh
    · exact hh
    · exact (ψ.continuous.comp (continuous_history H s) |>.mul
        (((continuous_value H f b f.continuous b.continuous).comp
          (continuous_id.prodMk continuous_const)).sub
        ((continuous_value H f b f.continuous b.continuous).comp
          (continuous_id.prodMk continuous_const)))).stronglyMeasurable.aestronglyMeasurable

end SHEStochastic.CanonicalCylinderRecognition
