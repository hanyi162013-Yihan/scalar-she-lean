module

public import SHE.GaussianFirstSplit
public import SHE.IntervalTerminalInput
public import SHE.PhysicalChainCovariance
public import SHE.NativeHeatSpan

@[expose] public section
set_option autoImplicit false
set_option maxHeartbeats 2400000
set_option backward.isDefEq.respectTransparency false
noncomputable section

namespace SHE.PhysicalFirstScore
open Set Filter MeasureTheory ProbabilityTheory AddCircle Real StoppedFourier
  WordRecursion StoppedGaussianFeatures OldIntervalCovariance PhysicalScoreChain
  PhysicalMeanRange HeatTorusKernel SmoothCylinders GaussianConvolution
open scoped BigOperators
local instance physicalFirstScore_nativePositive : Fact (0 < 2*π) := ⟨by positivity⟩
variable {n : ℕ}

/-- The literal terminal derivative direction generated by the original
native physical heat rows and one signed L² input. -/
def terminalDirection (Z : Fin n → Observation) (lo : ℝ) (v : StoppedFourier.CircleL2) : State n :=
  WithLp.toLp 2 (fun i => PhysicalProfile.physicalHeatMean v ((Z i).target-lo,(Z i).center))

theorem terminalDirection_eq_current (Z : Fin n → Observation) (lo : ℝ) (v : StoppedFourier.CircleL2) :
    terminalDirection Z lo v=currentDirection (fun i => (Z i).target)
      (fun i => NativeHeatSpan.unitCenter (Z i).center) lo v := by
  ext i
  change PhysicalProfile.physicalHeatMean v ((Z i).target-lo,(Z i).center)=
    PhysicalProfile.physicalHeatMean v ((Z i).target-lo,
      CircleNormalization.scale 1 (2*π) (NativeHeatSpan.unitCenter (Z i).center))
  rw [NativeHeatSpan.scale_inverse]

theorem terminalDirection_integral (Z : Fin n → Observation) {lo hi : ℝ}
    (hgap : lo < hi) (hstop : ∀ i, hi ≤ (Z i).stop) (hages : ∀ i, (Z i).stop ≤ (Z i).target)
    (v : StoppedFourier.CircleL2) (i : Fin n) :
    terminalDirection Z lo v i = ∫ x : HeatCircle, heatRow Z lo x i*(v x).re ∂haarAddCircle := by
  rw [terminalDirection_eq_current]
  have hh := IntervalMeanScore.currentDirection_integral (fun i => (Z i).stop) (fun i => (Z i).target)
    (fun i => NativeHeatSpan.unitCenter (Z i).center) lo (fun i => hgap.trans_le (hstop i)) hages v i
  rw [hh]
  apply integral_congr_ae
  exact ae_of_all _ (fun x => by
    change (if lo < (Z i).stop then
      (ProfileVariance.heatPhysical ((Z i).target-lo)
        (CircleNormalization.scale 1 (2*π) (NativeHeatSpan.unitCenter (Z i).center)) x).re else 0)*(v x).re=_
    rw [ite_eq_left (hgap.trans_le (hstop i)),NativeHeatSpan.scale_inverse]
    rfl)

theorem terminalDirection_mem_range (Z : Fin n → Observation)
    {lo hi ell M : ℝ} (hlo : 0 ≤ lo) (hgap : lo < hi)
    (hstop : ∀ i, hi ≤ (Z i).stop) (hages : ∀ i, (Z i).stop ≤ (Z i).target)
    (c : Domain → ℝ) (hc : Measurable c) (hell : 0 < ell)
    (hb : ∀ p, ell ≤ c p ∧ c p ≤ M) (v : StoppedFourier.CircleL2) :
    terminalDirection Z lo v ∈
      (Matrix.toEuclideanCLM (𝕜:=ℝ) (intervalCovariance Z c lo hi)).range := by
  let t : Fin n → ℝ := fun i => ((Z i).target-lo)/(4*π^2)
  have ht (i : Fin n) : 0 < t i := by
    apply div_pos _ (by positivity)
    linarith [hstop i,hages i]
  have hage (i : Fin n) : (Z i).target-lo=4*π^2*t i := by dsimp [t]; field_simp
  have hh := (IntervalMeanScore.native_direction_projection_bound
    (fun i => (Z i).stop) (fun i => (Z i).target) (fun i => NativeHeatSpan.unitCenter (Z i).center)
    hlo hgap hstop hages t ht hage c hc hell hb v).1
  have hcenter : StoppedGaussianScore.nativeCenter (fun i => NativeHeatSpan.unitCenter (Z i).center)=
      fun i => (Z i).center := funext (fun i => NativeHeatSpan.scale_inverse (Z i).center)
  rw [hcenter,← terminalDirection_eq_current] at hh
  exact hh

theorem interval_posSemidef (Z : Fin n → Observation) (hages : ∀ i, (Z i).stop ≤ (Z i).target)
    (c : Domain → ℝ) (hc : Measurable c) {M : ℝ} (hb : ∀ p, 0 ≤ c p ∧ c p ≤ M) (lo hi : ℝ) :
    (intervalCovariance Z c lo hi).PosSemidef := by
  have hg : Matrix.gram ℝ (IntervalScoreMass.feature (fun i => (Z i).stop) (fun i => (Z i).target)
      (fun i => (Z i).center) hages c hc M hb lo hi)=intervalCovariance Z c lo hi :=
    IntervalScoreMass.feature_gram (fun i => (Z i).stop) (fun i => (Z i).target)
      (fun i => (Z i).center) hages c hc M hb lo hi
  rw [← hg]
  exact Matrix.posSemidef_gram ℝ _

/-- A true terminal Fréchet derivative of the physical backward Gaussian
operator uses the first score of its actual fixed old interval. All
covariance and direction applicability is proved from ellipticity and
the original stop/target geometry. -/
theorem fderiv_interval (Z : Fin n → Observation)
    {lo hi ell M J : ℝ} (hlo : 0 ≤ lo) (hgap : lo < hi)
    (hstop : ∀ i, hi ≤ (Z i).stop) (hages : ∀ i, (Z i).stop ≤ (Z i).target)
    (c r : Domain → ℝ) (hc : Measurable c) (hr : Measurable r) (hell : 0 < ell)
    (hcb : ∀ p, ell ≤ c p ∧ c p ≤ M) (hrb : ∀ p, 0 ≤ r p ∧ r p ≤ J)
    {F : State n → ℝ} (hF : BoundedSmooth F) (z : State n) (v : StoppedFourier.CircleL2) :
    fderiv ℝ (gaussianAverage (WordRecursion.covariance (fun p => c p+r p) Z lo hi) F) z
      (terminalDirection Z lo v) =
      ∫ old, ∫ residual, F (z+old+residual)*MeasurableGaussianScores.firstScore
          (intervalCovariance Z c lo hi) (terminalDirection Z lo v) old
        ∂multivariateGaussian 0 (intervalCovariance Z r lo hi)
        ∂multivariateGaussian 0 (intervalCovariance Z c lo hi) := by
  have hM : 0 ≤ M := (hell.le.trans (hcb (0,0)).1).trans (hcb (0,0)).2
  have hJ : 0 ≤ J := (hrb (0,0)).1.trans (hrb (0,0)).2
  have hcab (p : Domain) : |c p| ≤ M := by rw [abs_of_nonneg (hell.le.trans (hcb p).1)]; exact (hcb p).2
  have hrab (p : Domain) : |r p| ≤ J := by rw [abs_of_nonneg (hrb p).1]; exact (hrb p).2
  have hsum := interval_add_profiles Z hages c r hc hr hM hJ hcab hrab lo hi
  have he := PhysicalIntervalCovariance.interval_eq_covariance Z (fun p => c p+r p) (hc.add hr)
    (fun p => (abs_add_le _ _).trans (add_le_add (hcab p) (hrab p))) hages hstop hlo hgap.le
  change intervalCovariance Z (fun p => c p+r p) lo hi=WordRecursion.covariance (fun p => c p+r p) Z lo hi at he
  rw [← he,hsum]
  exact GaussianFirstSplit.fderiv_split
    (interval_posSemidef Z hages c hc (fun p => ⟨hell.le.trans (hcb p).1,(hcb p).2⟩) lo hi)
    (interval_posSemidef Z hages r hr hrb lo hi)
    (terminalDirection_mem_range Z hlo hgap hstop hages c hc hell hcb v) hF z

end SHE.PhysicalFirstScore
