theorem spatial_zero (k:ℕ) (t:Fin k→ℝ)
    (hp:¬StrictHistory Zero k (MixedPastTerminalSlotSpatial.anchor k t)) (ν χ:ℝ) (y:Ω×HeatCircle):
    Spatial k ν χ t y=0:=by
  unfold MixedPastTerminalPairedAverage.spatial
  apply integral_eq_zero_of_ae
  apply ae_of_all
  intro w
  have hn:¬StrictHistory Zero k (separated k (y.2,t,fun l=>w l+y.2)):=by
    intro hh
    apply hp
    exact (FixedHistoryTimeFactors.strict_sections Zero (b:ℝ) (fun _=>rfl) k t y.2 0 _ (fun _=>0)).mp hh
  exact if_neg hn

include hIJ₀ hIJ₁ in
/-- Whole ACTUAL finite paired branch, globally on its original old-time
cube, with one positive integrable RMS amplitude. The true current energy
is still evaluated at its own newest terminal, including zero-age input. -/
theorem energy_ae
    (hlocal:StandardTerminalPastLocality J) (hΛ:0≤Λ) (hH:(H:ℝ)≤1)
    (hages:∀x i,(Z.observations x i).stop≤(Z.observations x i).target)
    (hrootstop:∀x i,(Z.observations x i).stop≤(b:ℝ))
    (hrootage:∀x i,(Z.observations x i).target=(b:ℝ))
    (hcenter:∀x i,(Z.observations x i).center=x)
    (hspan:(b:ℝ)-(v:ℝ)≤P.horizon) (hbH:b≤H)
    (hsmallP:memoryConstant P.lower P.holder P.exponent*
      ProfileVolterra.powerConstant ((P.exponent-1)/4)*P.horizon^(P.exponent/4)≤1/2)
    (k:ℕ) (hsmall:∀j,j<k+1→(b:ℝ)-(v:ℝ)≤uniformHorizon 1 j)
    {A0 ν χ:ℝ} (hA0:0≤A0) (hν:0≤ν) (hχ:0<χ) (hχβ:χ<P.exponent)
    (hjet:∀x j,j≤k+2→∀z,‖iteratedFDeriv ℝ j (F x) z‖≤A0*ν^j)
    (order:ℕ) (horder:0<order) (ho0:1≤(order:ℝ)*(1-χ))
    (ho1:1≤(order:ℝ)*(1-χ/P.exponent)) (B0 B1:ℝ≥0)
    (hBDG:StandardTerminalBDGPower (order*((k+1)+2)) J B0)
    (hBDG1:StandardTerminalBDGPower 1 J B1):
    ∀ᵐ t:Fin (k+1)→ℝ ∂Measure.pi (fun _=>volume.restrict (Ioc (v:ℝ) (b:ℝ))),
      Integrable (fun y:Ω×HeatCircle=>|Spatial (k+1) ν χ t y|^2) (μ.prod haarAddCircle) ∧
      (∫y,|Spatial (k+1) ν χ t y|^2 ∂μ.prod haarAddCircle)≤
        RMS (k+1) t ν χ A0 order B0^2*(En (k+1) t^χ+(∫ω,‖Dir ω‖^2 ∂μ)^χ):=by
  have hm:=MixedPastTerminalPairedAverage.energy_ae
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S J hIJ₀ hIJ₁ P haP v b hvb Z htarget hstop F hF hFm
    hlocal hΛ hH hages hrootstop hrootage hcenter hspan hbH hsmallP k hsmall hA0 hν hχ hχβ hjet
    order horder ho0 ho1 B0 B1 hBDG hBDG1
  filter_upwards [hm] with t ht
  by_cases hp:StrictHistory Zero (k+1) (MixedPastTerminalSlotSpatial.anchor (k+1) t)
  · refine ⟨(ht hp).2.1,(ht hp).2.2.trans ?_⟩
    exact MixedPastTerminalRMS.budget_sum_bound
      𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S P haP v b hvb Z htarget hstop F hF hFm
      (k+1) t hp ν χ A0 order B0
  · have hz(y:Ω×HeatCircle):Spatial (k+1) ν χ t y=0:=
      spatial_zero 𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S P haP v b hvb Z htarget hstop F hF hFm
        (k+1) t hp ν χ y
    have ha:RMS (k+1) t ν χ A0 order B0=0:=by
      simp only [MixedPastTerminalRMS.amplitude,ControlledTerminalPairedTime.amplitude,
        if_neg hp,mul_zero,Finset.sum_const_zero]
    simp only [hz,abs_zero,zero_pow (by decide : (2:ℕ)≠0),integral_zero,ha,zero_mul,le_refl,true_and]
    exact ⟨integrable_zero (Ω×HeatCircle) ℝ (μ.prod haarAddCircle),trivial⟩

