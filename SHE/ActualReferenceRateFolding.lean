def constant:ℝ:=NativeReferenceMasterFiniteCoefficient.constant Rough κ M N p
  (fun k=>CanonicalGaussianRootBands.amplitude D 1 (k+1))
  (fun k=>Bword k) (fun k=>Bref k) D.beta
local notation "RC"=>constant (κ:=κ) (M:=M) (D:=D) (hT:=hT) (hT1:=hT1) (hsmall:=hsmall)
  (N:=N) (p:=p) (Bword:=Bword) (Bref:=Bref)

/-- The exact actual reference K/q caps fold into a structural linear
true-energy row and the canonical sublinear reference-mean row. -/
theorem reference(hΛ:1≤Λ)(hH:(H:ℝ)≤1)
    (hρeq:ρ=SHE.rho D.beta)
    (hχeq:χref=ActualReferenceMasterClosure.referenceExponent D.beta)
    (hεeq:εref=D.beta/100)(hηeq:ηref=D.beta/100):
    (∑k:Fin N,RCap k)≤RC*(NativeReferenceMasterCoefficient.linear D.beta Λ*sqrt Global+
      Λ^(-D.beta/100)*(sqrt Global)^(ActualReferenceMasterClosure.referenceExponent D.beta)):=by
  subst ρ χref εref ηref
  have hg:0≤Global:=integral_nonneg (fun _=>sq_nonneg _)
  have he:(sqrt Global)^2=Global:=sq_sqrt hg
  have hr:1≤(2:ℝ)^(Jbase+1):=one_le_pow₀ (by norm_num:(1:ℝ)≤2)
  have ht:=NativeReferenceMasterFiniteCoefficient.cap Rough κ M N p
    (fun k=>CanonicalGaussianRootBands.amplitude D 1 (k+1))
    (fun k=>Bword k) (fun k=>Bref k) D.beta_pos D.beta_le hΛ (sqrt_nonneg Global) H.2 hH hr
  convert ht using 1 <;> simp only [constant,ActualGaussianFiniteRMS.referenceCap,NativeReferenceMasterCoefficient.degrees,he] <;> rfl

end SHE.ActualReferenceRateFolding
