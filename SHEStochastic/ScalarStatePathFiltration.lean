module

public import SHE.NativeContinuousPath
public import SHEStochastic.AdaptedCanonicalPathTests
public import SHEStochastic.NativeRowRepresentatives

@[expose] public section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
noncomputable section

namespace SHEStochastic.ScalarStatePathFiltration
open MeasureTheory Set SHE SHE.PredictableL2 SHE.DyadicApproximation SHE.FiniteHaar
open AdaptedCanonicalPathTests StoppedPathPasting
open scoped NNReal ENNReal

local instance : Fact (0 < (1 : ℝ)) := ⟨zero_lt_one⟩
local instance : Fact ((2 : ENNReal) ≠ ⊤) := ⟨by simp⟩
local instance : SecondCountableTopology CircleHeat.CircleL2 :=
  (_root_.fourierBasis (T := (1 : ℝ))).repr.toHomeomorph.secondCountableTopology
local instance : SecondCountableTopology RealL2 := realCircleIdentification.toHomeomorph.secondCountableTopology
local instance : MeasurableSpace RealL2 := borel _
local instance : BorelSpace RealL2 := ⟨rfl⟩

abbrev Space (H : ℝ≥0) := C(Icc (0 : ℝ) (H : ℝ), RealL2)

def state (H t : ℝ≥0) (z : Space H) : RealL2 := z (clock H t)

/-- The canonical filtration generated by the state alone. -/
def filtration (H : ℝ≥0) : Filtration ℝ≥0 (inferInstance : MeasurableSpace (Space H)) where
  seq t := ⨆ s : Iic t, MeasurableSpace.comap (state H s.1) inferInstance
  mono' _s t h := iSup_le fun r =>
    le_iSup_of_le (⟨r.1,r.2.trans h⟩ : Iic t) le_rfl
  le' _t := iSup_le fun r => (ContinuousMap.measurable_eval (clock H r.1) (Y := RealL2)).comap_le

theorem adapted (H t : ℝ≥0) : Measurable[filtration H t] (state H t) :=
  Measurable.of_comap_le (le_iSup_of_le (⟨t,le_rfl⟩ : Iic t) le_rfl)

theorem continuous_state (H : ℝ≥0) (z : Space H) : Continuous (fun t => state H t z) :=
  z.continuous.comp (continuous_clock H)

theorem predictable (H : ℝ≥0) : StronglyMeasurable[(filtration H).predictable]
    (Function.uncurry (state H)) :=
  StronglyAdapted.isStronglyPredictable_of_leftContinuous
    (fun t => (adapted H t).stronglyMeasurable)
    (fun z _t => (continuous_state H z).continuousWithinAt)

variable {Ω : Type*} [MeasurableSpace Ω]
  (F : Filtration ℝ≥0 ‹MeasurableSpace Ω›) (H : ℝ≥0)
  (W : ℝ≥0 → Ω → RealL2) (hc : ∀ ω,Continuous (fun t => W t ω))

local notation "p" => NativeContinuousPath.path H W hc

omit [MeasurableSpace Ω] in
theorem state_path (t : ℝ≥0) (ht : t≤H) (ω : Ω) :
    state H t (p ω)=W t ω := by
  change W (min (t : ℝ) (H : ℝ)).toNNReal ω=W t ω
  rw [min_eq_left (by exact_mod_cast ht),Real.toNNReal_coe]

theorem path_past (ha : StronglyAdapted F W) (t : ℝ≥0) :
    Measurable[F t,filtration H t] p := by
  apply Measurable.of_comap_le
  change MeasurableSpace.comap p (⨆ s : Iic t,MeasurableSpace.comap (state H s.1) inferInstance)≤F t
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro s
  rw [MeasurableSpace.comap_comp]
  have he : state H s.1 ∘ p = W (min s.1 H) := by
    funext ω
    change W (min (s.1 : ℝ) (H : ℝ)).toNNReal ω=W (min s.1 H) ω
    rw [←NNReal.coe_min,Real.toNNReal_coe]
  rw [he]
  exact ((ha (min s.1 H)).measurable.mono (F.mono ((min_le_left _ _).trans s.2)) le_rfl).comap_le

def pull (q : ℝ≥0×Ω) : ℝ≥0×Space H := (q.1,p q.2)

theorem predictable_pull (ha : StronglyAdapted F W) :
    Measurable[F.predictable,(filtration H).predictable] (pull H W hc) := by
  let _ : MeasurableSpace (ℝ≥0×Ω) := F.predictable
  unfold Filtration.predictable at *
  apply measurable_generateFrom
  intro s hs
  rcases hs with ⟨A,hA,rfl⟩ | ⟨t,A,hA,rfl⟩
  · exact measurableSet_predictable_singleton_bot_prod (𝓕 := F)
      ((path_past F H W hc ha 0) hA)
  · exact measurableSet_predictable_Ioi_prod (𝓕 := F)
      ((path_past F H W hc ha t) hA)

/-- Pullback from the common path law preserves both the physical
time-product measure and its predictable restriction. -/
theorem preserving (μ : Measure Ω) (ρ : Measure (Space H)) [IsProbabilityMeasure μ] [IsProbabilityMeasure ρ]
    (ha : StronglyAdapted F W) (hm : Measurable (Function.uncurry W)) (hρ : μ.map p=ρ) :
    @MeasurePreserving _ _ F.predictable (filtration H).predictable (pull H W hc) (FiniteScalarIto.inputMeasure F μ H)
      (FiniteScalarIto.inputMeasure (filtration H) ρ H) := by
  have hP : MeasurePreserving p μ ρ :=
    ⟨NativeContinuousPath.measurable_path H W hc hm,hρ⟩
  have hp : MeasurePreserving (pull H W hc) (energyMeasure μ H) (energyMeasure ρ H) :=
    (MeasurePreserving.id (PredictableL2.timeMeasure H)).prod hP
  have hpre (s : Set (ℝ≥0×Space H)) (hs : MeasurableSet s) :
      energyMeasure μ H (pull H W hc ⁻¹' s)=energyMeasure ρ H s := hp.measure_preimage hs.nullMeasurableSet
  have hpred := predictable_pull F H W hc ha
  let _ : MeasurableSpace (ℝ≥0×Ω) := F.predictable
  let _ : MeasurableSpace (ℝ≥0×Space H) := (filtration H).predictable
  refine ⟨hpred,?_⟩
  apply Measure.ext
  intro s hs
  have hs' := predictable_le_product (filtration H) _ hs
  have ht' := hpred hs
  rw [Measure.map_apply hpred hs,NativeRowRepresentatives.inputMeasure_eq,NativeRowRepresentatives.inputMeasure_eq,
    trim_measurableSet_eq _ ht',trim_measurableSet_eq _ hs]
  exact hpre s hs'

end SHEStochastic.ScalarStatePathFiltration
