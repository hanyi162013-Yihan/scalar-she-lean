theorem rough_relative_bound (hΛ:0≤Λ)
    (hrootage:∀x i,(Z.observations x i).target=(b:ℝ))
    (hcenter:∀x i,(Z.observations x i).center=x)
    (k:ℕ) (t:Fin k→ℝ) (choices:List (Fin k×Fin (k+1)))
    {ν χ:ℝ} (hν:0≤ν) (hχ:0≤χ) (j:Fin k) (x:HeatCircle) (w:Fin k→HeatCircle) (ω:Ω):
    let a:=MixedPastTerminalSlotSpatial.anchor k t
    let q:=(carrier Zero k).terminal a
    let idx:=leafIndex k (fun i:Fin (1+k)=>i) j
    let y:=values (fun _:Fin 1=>(0:HeatCircle)) k w idx
    |Src k choices ν χ j.succ (separated k (x,t,fun l=>w l+x)) ω|≤
      max 1 (P.holder^(χ/P.exponent))*|NativeCurrentSourceEnergy.value
        (fun ω=>S.first q.toNNReal ω) (fun ω=>S.second q.toNNReal ω)
        (targets Zero k a idx-q) (ω,x+y)|^χ+
      |profile P Λ (U ω) (Dir ω) (1,(targets Zero k a idx-(v:ℝ),x+y))-
        profile P Λ (U ω) (Dir ω) (0,(targets Zero k a idx-(v:ℝ),x+y))|^(χ/P.exponent):=by
  intro a q idx y
  let h:=separated k (x,t,fun l=>w l+x)
  have hq:(carrier Zero k).terminal h=q:=by
    dsimp [h,q,a,MixedPastTerminalSlotSpatial.anchor]
    rw [terminal_separated Zero (b:ℝ) (fun _=>rfl),terminal_separated Zero (b:ℝ) (fun _=>rfl)]
  have ht:targets Zero k h=targets Zero k a:=
    FixedHistoryTimeFactors.targets_sections Zero (b:ℝ) (fun _=>rfl) (fun _=>(b:ℝ)) hrootage
      k t x 0 _ (fun _=>0)
  have hc:centers Zero k h idx=x+y:=by
    have he:=congrFun (ScalarRootRelativeGeometry.centers_relative Zero hcenter k t x w) idx
    exact he.trans (add_comm _ _)
  rw [abs_of_nonneg (MixedPastTerminalSourceGeometry.source_nonneg
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ v₀ S
    P haP v b hvb Z htarget hstop F hF hFm k choices ν χ hν j.succ h ω)]
  have hh:=MixedPastTerminalSources.rough_source_le
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ v₀ S
    P haP v b hvb Z htarget hstop F hF hFm hΛ k h ω choices hχ (ν:=ν) j
  change _≤_ at hh
  rw [hq,congrFun ht idx,hc] at hh
  exact hh

