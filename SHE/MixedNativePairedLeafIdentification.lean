local notation "WordDiff"=>MixedPastTerminalEndpointWord.wordDifference 𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ u₀ S P haP v b hvb Z ht hs F hF hFm

/-- Exact actual paired terminal word, including every original stop,
target, current state, original past and nonstrict-history zero extension.
The ordinary leaf is independently evaluated on U, not joint theta0. -/
theorem raw_difference(hA:P.coefficient=(fun z=>κ+aV z))(k:ℕ)(h:History HeatCircle k)(ω:Ω):
    JR 0 k (h,ω)-OR 0 k (h,ω)=WordDiff k h ω:=by
  have hg:=ControlledPairedUncutLeafIdentity.leaf_difference P (fun z=>κ+aV z) hAs Λ v b hvb
    Z ht hs F hF hFm (DU).physicalState (DV).physicalState (DU).physicalField (DV).physicalField
    (pastParameter ω) k h ω
  simp only [MixedCanonicalRootFields.raw,MixedOrdinaryRootFields.raw,
    ControlledReferenceFamilyEvaluation.leaf,ite_true,MixedPastTerminalEndpointWord.wordDifference,
    MixedPastTerminalPairedFields.current,Bool.false_eq_true,↓reduceIte]
  generalize hC:(fun z=>κ+aV z)=C at hAs hg ⊢
  have hPC:C=P.coefficient:=hC.symm.trans hA.symm
  clear hC
  subst C
  convert! hg using 1 <;> rfl
end SHE.MixedNativePairedLeafIdentification
