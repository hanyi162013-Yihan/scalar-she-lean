/-- At the actual original output history, the covariance mass RMS is
truly theta-integrable on an AE spatial event, as a consequence of the
proved joint output energy. No local integrability hypothesis remains. -/
theorem mass_rms_integrable (hΛ:0≤Λ)
    (hsmallPoint:ProfileStability.memoryConstant P.lower P.holder P.exponent*
      ProfileVolterra.powerConstant ((P.exponent-2)/4)*P.horizon^(P.exponent/4)≤1/2)
    (hsmallL2:ProfileStability.memoryConstant P.lower P.holder P.exponent*
      ProfileVolterra.powerConstant ((P.exponent-1)/4)*P.horizon^(P.exponent/4)≤1/2)
    (hvH:v≤H)(hv1:(v:ℝ)≤1)(Bpast:ℝ≥0)(hBDGpast:StandardTerminalBDGPower 1 J Bpast)
    (hages:∀x i,(Z.observations x i).stop≤(Z.observations x i).target)
    (hrootTarget:∀x i,(Z.observations x i).target=(b:ℝ))
    (hrootStop:∀x i,(Z.observations x i).stop=(b:ℝ))
    (hcenter:∀x i,(Z.observations x i).center=x)
    (hspan:(b:ℝ)-(v:ℝ)≤P.horizon)(k:ℕ)(q:ℝ≥0)(hvq:v<q)
    (t:Fin k→ℝ)(ht:active Zero (b:ℝ) k q t)(w:Fin k→HeatCircle):
    ∀ᵐx:HeatCircle∂haarAddCircle,
      Integrable (fun θ=>Real.sqrt (∫ω,|Mass k θ q (separated k (x,t,fun i=>w i+x)) ω|^2 ∂μ))
        MeanThetaAverage.thetaMeasure:=by
  have he:=MixedPastNativeCovarianceThetaJoint.actual_joint_energy
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S J hIJ₀ hIJ₁
    P haP v b hvb Z htarget hstop F hF hFm hΛ hsmallPoint hsmallL2 hvH hv1 Bpast hBDGpast
    hages hspan k q hvq t ht w
  have hm:=(MixedPastNativeCovarianceThetaFields.scoreMass_joint_measurable
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S
    P haP v b hvb Z htarget hstop F hF hFm hΛ hsmallPoint k q t).comp
      (measurable_snd.fst.prodMk ((measurable_fst.prodMk measurable_snd.snd).prodMk
        (measurable_const (a:=w))))
  have hGm:=ScalarFibreRMS.measurable μ _ hm
  have hi:=ScalarThetaSections.integrable_sections MeanThetaAverage.thetaMeasure haarAddCircle _ hGm he.1
  filter_upwards [hi] with x hx
  have heq:(fun θ=>Real.sqrt (∫ω,|Mass k θ q (separated k (x,t,fun i=>w i+x)) ω|^2 ∂μ))=
      fun θ=>ScalarFibreRMS.rms μ (fun z:Ω×(ℝ×HeatCircle)=>RelativeMass k z.2.1 q t ((z.1,z.2.2),w)) (θ,x):=by
    funext θ
    simp only [ScalarFibreRMS.rms]
    congr 1
    apply integral_congr_ae
    exact ae_of_all _ (fun ω=>congrArg (fun a:ℝ=>|a|^2)
      (MixedPastNativeThetaCoordinates.mass_relative
        𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S
        P haP v b hvb Z htarget hstop F hF hFm hrootTarget hrootStop hcenter k θ q t w x ω))
  rw [heq]
  exact hx

end SHE.MixedPastNativeThetaSections
