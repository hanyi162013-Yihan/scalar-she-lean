/-- Literal own-profile, own-baseline terminal endpoint at the original
actual mixed current state; all old Gaussian coordinates are retained. -/
def endpoint (second:Bool) (k:ℕ) (h:History X k) (ω:Ω):ℝ:=
  let θ:ℝ:=if second then 1 else 0
  let p:ControlledProfile.Inputs:=(U ω,Dir ω)
  gaussianAverage
    (fullResidualCovariance (Base (θ,p)) (oldProfile P Λ v p) k h ((carrier Zero k).terminal h))
    (oldAverage (Base (θ,p)) (oldProfile P Λ v p) k h) (Cur second k h ω)

local notation "End"=>endpoint 𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ v₀ S
  P haP v b hvb Z htarget hstop F hF hFm

def difference (k:ℕ) (h:History X k) (ω:Ω):ℝ:=
  if StrictHistory Zero k h then End true k h ω-End false k h ω else 0

local notation "Diff"=>difference 𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ v₀ S
  P haP v b hvb Z htarget hstop F hF hFm

/-- The ACTUAL terminal endpoint difference equals exactly the covariance
FTC branch plus the full paired branch. ONE original history event works
for every actual random past and sample; no independence is used. -/
theorem endpoint_decomposition_ae
    (hages:∀x i,(Z.observations x i).stop≤(Z.observations x i).target)
    (ρ:Measure X) [IsFiniteMeasure ρ] (k:ℕ)
    {A0 ν χ:ℝ} (hA0:0≤A0) (hν:0≤ν) (hχ:0≤χ) (hχβ:χ≤P.exponent)
    (hjet:∀x j,j≤k+1→∀z,‖iteratedFDeriv ℝ j (F x) z‖≤A0*ν^j):
    ∀ᵐ h ∂historyMeasure (referenceData P P.coefficient haP Λ 0 v b hvb (0,0)) ρ k,
      ∀ω:Ω,IntervalIntegrable (fun ζ=>G k ζ h ω) volume 0 1 ∧
      Diff k h ω=(∫ζ in (0:ℝ)..1,G k ζ h ω)+Pair k ν χ h ω:=by
  filter_upwards [ControlledFiniteEndpointComparison.comparison_ae
    P haP Λ v b hvb Z htarget hstop F hF hFm hages ρ k] with h hh
  intro ω
  by_cases hp:StrictHistory Zero k h
  · have hc:=hh (U ω,Dir ω) (Cur true k h ω) (Cur false k h ω) A0 ν χ
      hA0 hν hχ hχβ (hjet (rootParameter k h))
    have hmark(ζ:ℝ):G k ζ h ω=ControlledFiniteCovarianceFields.point
        P haP Λ v b hvb Z htarget hstop F hF hFm (1,(U ω,Dir ω)) k h
        ((carrier Zero k).terminal h) 0 1 ζ (Cur true k h ω):=by
      simp only [MixedPastTerminalCovarianceFields.active,ite_eq_left hp,
        MixedPastTerminalFiniteCovariance.point,MixedPastTerminalFiniteCovariance.terminalMean,
        sub_self,zero_smul,one_smul,zero_add]
    dsimp only at hc
    simp_rw [←hmark] at hc
    refine ⟨hc.1,?_⟩
    unfold difference MixedPastTerminalPairedWord.point
    rw [ite_eq_left hp,ite_eq_left hp]
    convert! hc.2 using 1
  · simp [MixedPastTerminalCovarianceFields.active,difference,MixedPastTerminalPairedWord.point,hp]

