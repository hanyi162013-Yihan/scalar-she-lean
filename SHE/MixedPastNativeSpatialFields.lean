/-- Literal original old-space averaged complete field is jointly
Borel before taking its negative realization or applying noise columns. -/
theorem measurable (k:ℕ)(q:ℝ≥0)(r:ℝ)(t:Fin k→ℝ):Measurable (Spatial k q r t):=by
  have hJoint:=MixedPastNativeKernelAverage.field_joint_measurable
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S P haP v b hvb Z htarget hstop F hF hFm k q r t
  have hm:=hJoint.comp ((measurable_snd.prodMk measurable_fst.fst).prodMk measurable_fst.snd)
  have hi:=hm.stronglyMeasurable.integral_prod_right'
    (ν:=Measure.pi (fun _:Fin k=>haarAddCircle))
  convert! hi.measurable using 1
  funext z
  symm
  exact MixedPastNativeKernelAverage.average_eq_spatial
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S P haP v b hvb Z htarget hstop F hF hFm k q r t z.1 z.2.1 z.2.2

/-- A fixed-time smooth cap is used only for actual Borel/Fubini
realization; it is not charged to the quantitative current/past budget. -/
theorem bound (k:ℕ)(q:ℝ≥0)(r:ℝ)(t:Fin k→ℝ):
    ∃B:ℝ,0≤B ∧ ∀ω y x,‖Spatial k q r t (ω,(y,x))‖≤B:=by
  obtain ⟨B,hB,hbound⟩:=MixedPastNativeKernel.field_bound
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S P haP v b hvb Z htarget hstop F hF hFm k q r t
  refine ⟨B,hB,fun ω y x=>?_⟩
  rw [←MixedPastNativeKernelAverage.average_eq_spatial
    𝓕 μ H Λ κ hκ haU haV hell hbU hbV I₀ I₁ u₀ S P haP v b hvb Z htarget hstop F hF hFm k q r t ω y x]
  simpa only [probReal_univ,mul_one] using norm_integral_le_of_norm_le_const
    (μ:=Measure.pi (fun _:Fin k=>haarAddCircle)) (C:=B)
    (ae_of_all _ (fun w=>hbound w ω y x))
